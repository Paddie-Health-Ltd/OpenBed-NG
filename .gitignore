node_modules/
dist/
.next/
coverage/
*.tsbuildinfo

# Vitest / CI artefacts. The glob matters: the workflow writes junit-db.xml,
# junit-compliance.xml, junit-e2e.xml and junit-ratchet.xml, none of which the
# bare `junit.xml` pattern matched.
junit*.xml
attestation.json

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Local env. NOTHING in this repo may require a production credential to run.
.env
.env.*
!.env.example

# Cloudflare Pages Functions local secrets. `wrangler pages dev` reads a Function's
# environment -- including the service-role key -- from `.dev.vars`, and `.env.*`
# above does not match it. Added 2026-09-18 by R-2026-09-18-16, on main and ahead of
# the Bundle 1 code that uses it, because an untracked file holding a service key is
# one `git add -A` from a public repository and naming files at staging protects one
# commit, not the next session. Verified before adding: no `.dev.vars` has ever been
# committed on any ref, in any stash or in the reflog. `.dev.vars.example` names the
# variables, never their values.
# `.dev.vars.*` added 2026-09-19 by R-2026-09-18-17: wrangler loads
# `.dev.vars.<environment>` in preference to `.dev.vars` (observed in the pinned
# wrangler 4.134.0), and the bare line above did not match it. The negation must
# stay AFTER the glob or the glob re-ignores the template.
.dev.vars
.dev.vars.*
!.dev.vars.example

# wrangler's local state, and the bundled Pages Functions output built by
# `npm run build:functions` so the service-role bundle guard can scan what the
# Function actually ships (it bundles packages/snapshot/src/serve.ts in, which the
# functions/ source does not contain). Both generated, never committed.
.wrangler/
.functions-build/

# The build stamp: generated by scripts/stamp_build.mjs at build time, read from
# the deployed site as /version.json. The FILE is ignored, never the directory --
# each app's public/ is tracked and holds robots.txt, and ignoring the directory
# would silently drop the crawler directive from every build.
#
# ONE EXACT PATH PER APP, and none of them ends in "/". Two properties depend on
# that: tests/compliance/build_stamp.test.ts asserts `git check-ignore` returns
# exactly these strings, and tests/compliance/eslint_ignores_cover_gitignore.test.ts
# derives its corpus from the lines that DO end in "/", so a directory entry here
# would silently demand an ESLint ignore that nothing adds.
apps/public-dashboard/public/version.json
apps/ward-console/public/version.json

.DS_Store
