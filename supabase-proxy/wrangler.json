{
  "name": "supabase-proxy",
  "main": "index.js",
  "compatibility_date": "2024-01-01",
  "routes": [
    { "pattern": "api.openbed.ng", "custom_domain": true }
  ],
  "ratelimits": [
    { "name": "LIMIT_OTP", "namespace_id": "3101", "simple": { "limit": 5, "period": 10 } },
    { "name": "LIMIT_VERIFY", "namespace_id": "3102", "simple": { "limit": 5, "period": 10 } },
    { "name": "LIMIT_REFRESH", "namespace_id": "3103", "simple": { "limit": 10, "period": 10 } }
  ],
  "observability": { "enabled": false }
}
