# Response headers for every static asset of the ward console (Cloudflare Pages
# `_headers`; R-2026-09-24-88 BP-10, PR 3.4b-app B). tests/compliance/security_headers.test.ts
# holds this file to its rule. connect-src is 'self' plus exactly the API origins
# packages/origins/origins.json gives apiOrigin() -- production and local, because the
# origin is chosen at run time by hostname -- and never the direct *.supabase.co origin:
# the emailed sign-in link opens there as a navigation, which connect-src does not govern.
# Referrer-Policy no-referrer: the sign-in lands with tokens in the URL fragment.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://api.openbed.ng http://127.0.0.1:54321; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
